# Copiá este archivo a .env.local y completá los valores (nunca subas .env.local al repo).
# En Vercel ya están cargadas como variables de entorno del proyecto.

# Client ID y Client secret del cliente OAuth de Google Cloud
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Secreto para firmar la sesión. Generalo con: npx auth secret
AUTH_SECRET=
